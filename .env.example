# Copy to .env locally; never commit .env.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash
# Set this to enable a password gate AND allow the app to use a shared server key.
APP_ACCESS_PASSWORD=
# Keep false for public apps. Users can enter their own key in the sidebar.
ALLOW_SHARED_KEY=false
